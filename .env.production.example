# Copie para .env.production no servidor e ajuste. Nao coloque segredos aqui.
# A porta web e publicada somente em loopback para um proxy HTTPS no host.
STECAR_PUBLIC_URL=https://stecar.exemplo.gov.br
STECAR_BIND_ADDRESS=127.0.0.1
STECAR_WEB_PORT=8080
STECAR_IMAGE_TAG=release-1

# Conta inicial criada somente se o banco estiver vazio para este email.
STECAR_ADMIN_EMAIL=administrador@exemplo.gov.br
STECAR_ADMIN_NOME=Administrador Geral

# SMTP e opcional, mas necessario para recuperacao de senha por email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=
